{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/editResume": [
        "./app/(home)/dashboard/index.ts"
      ],
      "@/components": [
        "./components/index.ts"
      ],
      "@/hooks": [
        "./hooks/index.ts"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/context/*": [
        "context/index.ts"
      ],
      "@/types/*": [
        "types/index.ts"
      ],
      "@/shared/*": [
        "app/(home)/dashboard/document/[documentId]/edit/EditResume/shared/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
